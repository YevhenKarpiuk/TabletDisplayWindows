{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: debug x64",
      "type": "process",
      "command": "${workspaceFolder}\\build.cmd",
      "args": ["Debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: release x64",
      "type": "process",
      "command": "${workspaceFolder}\\build.cmd",
      "args": ["Release"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run: host check",
      "type": "process",
      "command": "${workspaceFolder}\\artifacts\\x64\\Debug\\host\\TabletDisplayHost.exe",
      "args": ["--check"],
      "dependsOn": "build: debug x64",
      "problemMatcher": []
    }
  ]
}
