;
; TabletDisplayDriver.inf
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=TabletDisplayDriver.cat
DriverVer= ; populated by StampInf

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...22000

[Standard.NT$ARCH$.10.0...22000]
%DeviceName%=TabletDisplay_Install,Root\TabletDisplayDriver
%DeviceName%=TabletDisplay_Install,TabletDisplayDriver

[SourceDisksFiles]
TabletDisplayDriver.dll=1

[SourceDisksNames]
1=%DiskName%

[TabletDisplay_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[TabletDisplay_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=TabletDisplay_HardwareDeviceSettings

[TabletDisplay_HardwareDeviceSettings]
HKR,,"UpperFilters",%REG_MULTI_SZ%,"IndirectKmd"
HKR,,"Security",%REG_SZ%,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GR;;;BU)"
HKR,"WUDF","DeviceGroupId",%REG_SZ%,"TabletDisplayDriverGroup"

[TabletDisplay_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[TabletDisplay_Install.NT.Wdf]
UmdfService=TabletDisplayDriver,TabletDisplayDriver_Install
UmdfServiceOrder=TabletDisplayDriver
UmdfKernelModeClientPolicy=AllowKernelModeClients

[TabletDisplayDriver_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\TabletDisplayDriver.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF

[UMDriverCopy]
TabletDisplayDriver.dll

[Strings]
ManufacturerName="TabletDisplay"
DiskName="TabletDisplay Driver Installation Disk"
DeviceName="TabletDisplay Virtual Display"
REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
